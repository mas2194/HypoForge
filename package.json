{
  "name": "my_harness",
  "version": "0.1.0",
  "description": "Autonomous Agent Harness for Evidence-based Architecture Exploration",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "server": "tsx src/main.ts --server",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest --fileParallelism=false",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "autonomous-agent",
    "codex",
    "harness",
    "architecture-exploration"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@openai/agents": "^0.18.0",
    "@openai/codex-sdk": "^0.156.1",
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.5.2"
}
